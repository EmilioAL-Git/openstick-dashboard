  "-m 0 -J") echo '{"modem":{"generic":{"state":"registered","power-state":"on","signal-quality":{"value":"72"},"access-technologies":["lte"],"manufacturer":"QUALCOMM","model":"MSM8916","revision":"N958St","sim":"/org/freedesktop/ModemManager1/SIM/0","unlock-required":"--"},"3gpp":{"operator-name":"Movistar","registration-state":"home","imei":"000000000000000"}}}';;
  "-i 0 -J") echo '{"sim":{"properties":{"iccid":"8934000000000000001","imsi":"214030000000001","operator-code":"21403","operator-name":"Orange"}}}';;
  *) echo "FAKE mmcli $*" >> /tmp/osp_calls.log;;
esac
