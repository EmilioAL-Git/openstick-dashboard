#!/bin/sh
case "$*" in
  "ip -4") echo 100.64.0.10;;
  "status --json") echo '{"BackendState":"Running","Self":{"HostName":"openstick","TailscaleIPs":["100.64.0.10"]},"Peer":{"a":{"Online":true},"b":{"Online":false}}}';;
  "debug prefs") echo '{"RouteAll":true}';;
  *) echo "FAKE tailscale $*" >> /tmp/osp_calls.log;;
esac
